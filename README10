import requests
import urllib3
import os

# Disabilita gli avvisi per le richieste HTTP non sicure dovute a verify=False
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# --- CONFIGURAZIONE ---
JIRA_URL = "https://tuo-dominio-jira.com"
USERNAME = "tuo_username_o_email"
API_TOKEN = "tua_password_o_api_token"
FILE_CHIAVI = "issue_keys.txt"
# ----------------------

def format_size(size_bytes):
    """Converte i byte in un formato leggibile (KB, MB, GB)."""
    if size_bytes == 0:
        return "0 B"
    size_name = ("B", "KB", "MB", "GB", "TB")
    i = 0
    p = size_bytes
    while p >= 1024 and i < len(size_name) - 1:
        p /= 1024.0
        i += 1
    return f"{p:.2f} {size_name[i]}"

def main():
    if not os.path.exists(FILE_CHIAVI):
        print(f"Errore: Il file '{FILE_CHIAVI}' non esiste nel percorso indicato.")
        return

    with open(FILE_CHIAVI, 'r') as f:
        # Rimuove righe vuote e spazi bianchi
        issue_keys = [line.strip() for line in f if line.strip()]

    if not issue_keys:
        print("Nessuna chiave trovata nel file.")
        return

    print(f"Trovate {len(issue_keys)} chiavi. Avvio calcolo pesi...")

    # Usare Session migliora le performance riciclando la connessione sottostante
    session = requests.Session()
    session.auth = (USERNAME, API_TOKEN)
    
    # Bypass del controllo SSL come richiesto
    session.verify = False 

    total_weight_bytes = 0
    total_attachments = 0

    for key in issue_keys:
        # La query string ?fields=attachment assicura che Jira ci restituisca SOLO i metadati degli allegati
        url = f"{JIRA_URL}/rest/api/2/issue/{key}?fields=attachment"
        
        try:
            response = session.get(url, timeout=10)
            
            if response.status_code == 200:
                data = response.json()
                attachments = data.get("fields", {}).get("attachment", [])
                
                # Somma i byte di tutti gli allegati della specifica issue
                issue_weight = sum(att.get("size", 0) for att in attachments)
                
                total_weight_bytes += issue_weight
                total_attachments += len(attachments)
                
                print(f"[{key}] {len(attachments)} allegati -> {format_size(issue_weight)}")
                
            elif response.status_code == 404:
                print(f"[{key}] ERRORE: Issue non trovata o l'utente non ha i permessi di lettura.")
            else:
                print(f"[{key}] ERRORE: {response.status_code} - {response.text}")
                
        except requests.exceptions.RequestException as e:
            print(f"[{key}] ERRORE DI CONNESSIONE: {e}")

    print("\n" + "="*40)
    print("RESOCONTO FINALE")
    print("="*40)
    print(f"Issue analizzate con successo: {len(issue_keys)}")
    print(f"Numero totale allegati: {total_attachments}")
    print(f"Peso complessivo: {format_size(total_weight_bytes)}")

if __name__ == "__main__":
    main()
