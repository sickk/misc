import urllib.request
import urllib.parse
import urllib.error
import json
import csv
import sys
import os

# ==========================================
# CONFIGURAZIONE
# ==========================================
GITLAB_URL = 'https://gitlab.com'
PRIVATE_TOKEN = 'INSERISCI_IL_TUO_TOKEN_QUI'
INPUT_FILE = 'repos.txt'
OUTPUT_FILE = 'output.csv'

def get_last_commit(repo_name):
    # Regola d'oro delle API REST di GitLab: il path (gruppo/repo) deve essere URL-encoded
    encoded_repo = urllib.parse.quote_plus(repo_name)
    
    # Endpoint per ottenere l'ultimo commit del branch di default (paginazione limitata a 1 per efficienza)
    api_url = f"{GITLAB_URL}/api/v4/projects/{encoded_repo}/repository/commits?per_page=1"
    
    req = urllib.request.Request(api_url)
    req.add_header('PRIVATE-TOKEN', PRIVATE_TOKEN)
    
    try:
        with urllib.request.urlopen(req) as response:
            if response.status == 200:
                data = json.loads(response.read().decode('utf-8'))
                if data and len(data) > 0:
                    last_commit = data[0]
                    return last_commit.get('created_at', 'N/A'), last_commit.get('author_name', 'N/A'), 'OK'
                else:
                    return 'N/A', 'N/A', 'Repository vuoto'
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return 'N/A', 'N/A', 'Errore 404: Non trovato (o permessi insufficienti)'
        elif e.code == 401:
             return 'N/A', 'N/A', 'Errore 401: Token non valido'
        else:
            return 'N/A', 'N/A', f'Errore HTTP: {e.code}'
    except urllib.error.URLError as e:
        return 'N/A', 'N/A', f'Errore di rete: {e.reason}'
    except Exception as e:
        return 'N/A', 'N/A', f'Eccezione: {str(e)}'

def main():
    if not os.path.exists(INPUT_FILE):
        print(f"Errore: Il file {INPUT_FILE} non esiste.")
        sys.exit(1)

    with open(INPUT_FILE, 'r', encoding='utf-8') as f:
        repo_names = [line.strip() for line in f if line.strip()]

    print(f"Trovati {len(repo_names)} repository. Elaborazione (nessuna libreria esterna)...")

    results = []
    
    for repo_name in repo_names:
        date, author, status = get_last_commit(repo_name)
        
        results.append({
            'Repository': repo_name,
            'Last_Commit_Date': date,
            'Last_Commit_Author': author,
            'Status': status
        })

    try:
        with open(OUTPUT_FILE, 'w', newline='', encoding='utf-8') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=['Repository', 'Last_Commit_Date', 'Last_Commit_Author', 'Status'])
            writer.writeheader()
            writer.writerows(results)
        print(f"\nCompletato. CSV generato con successo: {OUTPUT_FILE}")
    except IOError as e:
         print(f"Errore I/O durante la scrittura del file CSV: {e}")

if __name__ == '__main__':
    main()
