import urllib.request
import urllib.parse
import urllib.error
import json
import csv
import sys
import os

# ==========================================
# CONFIGURAZIONE
# ==========================================
GITLAB_URL = 'https://gitlab.com'
PRIVATE_TOKEN = 'INSERISCI_IL_TUO_TOKEN_QUI'
INPUT_FILE = 'repos.txt'
OUTPUT_FILE = 'output.csv'

def make_api_call(url):
    """Funzione helper per eseguire chiamate HTTP alle API di GitLab"""
    req = urllib.request.Request(url)
    req.add_header('PRIVATE-TOKEN', PRIVATE_TOKEN)
    try:
        with urllib.request.urlopen(req) as response:
            if response.status == 200:
                return json.loads(response.read().decode('utf-8')), None
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}"
    except urllib.error.URLError as e:
        return None, f"Network Error: {e.reason}"
    except Exception as e:
        return None, f"Error: {str(e)}"

def process_repository(repo_search_term):
    """Cerca il progetto per nome, poi ne estrae i commit"""
    
    # FASE 1: Ricerca del progetto
    # Usiamo il parametro 'search' sulle API dei progetti
    encoded_search = urllib.parse.quote_plus(repo_search_term)
    search_url = f"{GITLAB_URL}/api/v4/projects?search={encoded_search}"
    
    projects_data, search_error = make_api_call(search_url)
    
    if search_error:
        return 'N/A', 'N/A', f'Errore Ricerca: {search_error}'
    
    if not projects_data or len(projects_data) == 0:
        return 'N/A', 'N/A', 'Non trovato: Nessun progetto corrisponde a questa ricerca'

    # Prendiamo il primo risultato (il più rilevante secondo GitLab)
    target_project = projects_data[0]
    project_id = target_project['id']
    actual_path = target_project['path_with_namespace']
    
    # Prepariamo un warning se la ricerca è troppo generica e restituisce omonimie
    status_msg = 'OK'
    if len(projects_data) > 1:
        status_msg = f"Warning: trovati {len(projects_data)} progetti. Estratto: {actual_path}"
    elif target_project['name'] != repo_search_term:
        # Se cerchi 'api' e lui trova 'my-api-gateway'
        status_msg = f"Warning: match parziale. Estratto: {actual_path}"

    # FASE 2: Estrazione dell'ultimo commit tramite l'ID numerico sicuro
    commits_url = f"{GITLAB_URL}/api/v4/projects/{project_id}/repository/commits?per_page=1"
    
    commits_data, commit_error = make_api_call(commits_url)
    
    if commit_error:
         return 'N/A', 'N/A', f'Errore Commit: {commit_error}'
         
    if not commits_data or len(commits_data) == 0:
        return 'N/A', 'N/A', f'Repo vuoto ({actual_path})'
        
    last_commit = commits_data[0]
    return last_commit.get('created_at', 'N/A'), last_commit.get('author_name', 'N/A'), status_msg


def main():
    if not os.path.exists(INPUT_FILE):
        print(f"Errore: Il file {INPUT_FILE} non esiste.")
        sys.exit(1)

    with open(INPUT_FILE, 'r', encoding='utf-8') as f:
        repo_names = [line.strip() for line in f if line.strip()]

    print(f"Trovati {len(repo_names)} repository. Esecuzione (Fase 1: Search -> Fase 2: Commits)...")

    results = []
    
    for repo_name in repo_names:
        date, author, status = process_repository(repo_name)
        
        results.append({
            'Search_Term': repo_name,
            'Last_Commit_Date': date,
            'Last_Commit_Author': author,
            'Status': status
        })

    try:
        with open(OUTPUT_FILE, 'w', newline='', encoding='utf-8') as csvfile:
            writer = csv.DictWriter(csvfile, fieldnames=['Search_Term', 'Last_Commit_Date', 'Last_Commit_Author', 'Status'])
            writer.writeheader()
            writer.writerows(results)
        print(f"\nCompletato. CSV generato con successo: {OUTPUT_FILE}")
    except IOError as e:
         print(f"Errore I/O durante la scrittura del file CSV: {e}")

if __name__ == '__main__':
    main()
