import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry
import json
import os
import sys

# --- CONFIGURAZIONE ---
DOMINIO = "jira.tua-azienda.com" # Probabilmente non è .atlassian.net
BEARER_TOKEN = "il_tuo_personal_access_token_oppure_oauth_token"

JQL = 'project = "DEV" AND status = "In Progress" ORDER BY created ASC'

FILE_DATI = "jira_issues_export.jsonl"
FILE_CHECKPOINT = "jira_sync_state.json"
MAX_RESULTS = 100

def crea_sessione_resiliente(bearer_token):
    session = requests.Session()
    
    # Iniezione dell'header per l'autenticazione Bearer
    session.headers.update({
        "Accept": "application/json",
        "Authorization": f"Bearer {bearer_token}"
    })

    retries = Retry(
        total=5, 
        backoff_factor=2, 
        status_forcelist=[429, 500, 502, 503, 504],
        respect_retry_after_header=True
    )
    
    adapter = HTTPAdapter(max_retries=retries)
    session.mount('https://', adapter)
    session.mount('http://', adapter) # Se per caso l'istanza interna non è in HTTPS
    
    return session

def leggi_checkpoint(jql_query):
    if os.path.exists(FILE_CHECKPOINT):
        with open(FILE_CHECKPOINT, 'r') as f:
            stato = json.load(f)
            if stato.get("jql") == jql_query:
                return stato.get("start_at", 0)
            else:
                print("⚠️ Attenzione: La JQL è cambiata rispetto al checkpoint. Ricomincio da zero.")
    return 0

def salva_checkpoint(jql_query, start_at):
    stato = {
        "jql": jql_query,
        "start_at": start_at
    }
    tmp_file = f"{FILE_CHECKPOINT}.tmp"
    with open(tmp_file, 'w') as f:
        json.dump(stato, f)
    os.replace(tmp_file, FILE_CHECKPOINT)

def estrai_issue():
    # Passiamo il token alla funzione di creazione sessione
    session = crea_sessione_resiliente(BEARER_TOKEN)
    url = f"https://{DOMINIO}/rest/api/2/search" # Spesso Jira Server/DC usa l'API v2
    
    start_at = leggi_checkpoint(JQL)
    totale_issue = start_at + 1 
    
    modalita_file = 'a' if start_at > 0 else 'w'
    
    print(f"🚀 Inizio estrazione. JQL: {JQL}")
    print(f"📍 Ripresa dal record: {start_at}")

    with open(FILE_DATI, modalita_file, encoding='utf-8') as file_out:
        
        while start_at < totale_issue:
            query = {
                'jql': JQL,
                'startAt': start_at,
                'maxResults': MAX_RESULTS,
                'fields': 'summary,status,assignee,created' 
            }

            try:
                response = session.get(url, params=query, timeout=30)
                # Intercetta esplicitamente errori di autorizzazione 401/403
                if response.status_code in (401, 403):
                     print(f"\n❌ Errore di Autenticazione (HTTP {response.status_code}).")
                     print("Il Bearer Token è scaduto, malformato o non ha i permessi per questa query.")
                     sys.exit(1)
                
                response.raise_for_status() 
            except requests.exceptions.RequestException as e:
                print(f"\n❌ Errore critico di connessione non recuperabile: {e}")
                print(f"💾 Lo stato è salvato. Rilancia lo script per riprendere da {start_at}.")
                sys.exit(1)

            data = response.json()
            totale_issue = data.get('total', 0)
            issues = data.get('issues', [])

            if not issues:
                break

            for issue in issues:
                file_out.write(json.dumps(issue) + '\n')
            
            file_out.flush()
            os.fsync(file_out.fileno())

            start_at += len(issues)
            salva_checkpoint(JQL, start_at)

            print(f"✅ Estratte e salvate {start_at} di {totale_issue} issue...")

    print("🎉 Estrazione completata con successo.")
    if os.path.exists(FILE_CHECKPOINT):
        os.remove(FILE_CHECKPOINT)

if __name__ == "__main__":
    estrai_issue()
