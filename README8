import os
import requests
from requests.auth import HTTPBasicAuth

# --- CONFIGURAZIONI (da inserire come variabili d'ambiente) ---
SOURCE_JIRA_URL = os.getenv("SOURCE_JIRA_URL") # es: "https://source.atlassian.net"
SOURCE_USER = os.getenv("SOURCE_USER")
SOURCE_TOKEN = os.getenv("SOURCE_TOKEN")
SOURCE_BOARD_ID = os.getenv("SOURCE_BOARD_ID")

DEST_JIRA_URL = os.getenv("DEST_JIRA_URL")     # es: "https://dest.atlassian.net"
DEST_USER = os.getenv("DEST_USER")
DEST_TOKEN = os.getenv("DEST_TOKEN")
DEST_BOARD_ID = os.getenv("DEST_BOARD_ID")

def get_sprints(base_url, user, token, board_id):
    """Recupera tutti gli sprint da una board specifica gestendo la paginazione."""
    sprints = []
    start_at = 0
    is_last = False
    auth = HTTPBasicAuth(user, token)
    
    while not is_last:
        url = f"{base_url}/rest/agile/1.0/board/{board_id}/sprint?startAt={start_at}"
        response = requests.get(url, auth=auth, headers={"Accept": "application/json"})
        response.raise_for_status()
        
        data = response.json()
        sprints.extend(data.get("values", []))
        
        is_last = data.get("isLast", True)
        start_at += len(data.get("values", []))
        
    return sprints

def create_sprint(base_url, user, token, target_board_id, sprint_data):
    """Crea un singolo sprint nella board di destinazione."""
    url = f"{base_url}/rest/agile/1.0/sprint"
    auth = HTTPBasicAuth(user, token)
    
    # Costruiamo il payload prendendo solo i dati utili e mappando la nuova board
    payload = {
        "name": sprint_data.get("name"),
        "originBoardId": int(target_board_id),
        "goal": sprint_data.get("goal", "")
    }
    
    # Jira API accetta startDate e endDate solo se lo sprint non è in stato 'closed' dalla nascita, 
    # ma lo gestiamo per provare a mantenere le date.
    if "startDate" in sprint_data:
        payload["startDate"] = sprint_data["startDate"]
    if "endDate" in sprint_data:
        payload["endDate"] = sprint_data["endDate"]

    response = requests.post(url, json=payload, auth=auth, headers={
        "Accept": "application/json",
        "Content-Type": "application/json"
    })
    
    if response.status_code == 201:
        print(f"✅ Sprint '{payload['name']}' creato con successo.")
    else:
        print(f"❌ Errore creazione '{payload['name']}': {response.text}")

def main():
    print("Inizio migrazione sprint...")
    try:
        source_sprints = get_sprints(SOURCE_JIRA_URL, SOURCE_USER, SOURCE_TOKEN, SOURCE_BOARD_ID)
        print(f"Trovati {len(source_sprints)} sprint nella board sorgente.")
        
        for sprint in source_sprints:
            create_sprint(DEST_JIRA_URL, DEST_USER, DEST_TOKEN, DEST_BOARD_ID, sprint)
            
    except requests.exceptions.HTTPError as e:
        print(f"Errore di comunicazione con le API: {e}")

if __name__ == "__main__":
    main()
